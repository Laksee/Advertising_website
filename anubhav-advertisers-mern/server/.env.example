# Copy this file to .env and fill in your own values.

# Local MongoDB:   mongodb://127.0.0.1:27017/signal-advertising
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/signal-advertising
MONGODB_URI=mongodb://127.0.0.1:27017/signal-advertising

# Port the Express API listens on
PORT=5000

# Origin allowed to call the API (the Vite dev server by default)
CLIENT_URL=http://localhost:5173
